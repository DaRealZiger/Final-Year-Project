flowchart TD
  START([START])
  Sale[Make Sale]
  Count["Count + (Sell Quantity)"]
  Check{Count >= 12?}
  CashBack[Give CashBack]
  NewCycle[Start New Cycle]
  2Check[Count - 12]
  END([END])
  START --> Sale --> Count --> Check
  Check --> |TRUE| CashBack --> NewCycle --> 2Check --> Check
  Check --> |FALSE| END
